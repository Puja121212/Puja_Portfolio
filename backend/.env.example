# ============================================================
# BACKEND ENVIRONMENT VARIABLES — Copy this to .env
# ============================================================
# IMPORTANT: Never commit your actual .env file to GitHub!
# ============================================================

# Database Configuration
# Get your MongoDB URI from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio

# Server Configuration
PORT=5002
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Production values (update these when deploying)
# NODE_ENV=production
# FRONTEND_URL=https://your-portfolio-domain.com
